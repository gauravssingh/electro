# ELNet Upstream Configuration
# Base URL for your community ELNet API (e.g. http://your-elnet-host:8091)
ELNET_BASE_URL=http://your-elnet-host:8091

# ELNet Account Credentials (required for automated polling)
ELNET_USERNAME=your_username_here
ELNET_PASSWORD=your_password_here

# 32-character AES Key and 16-character IV (extracted locally from Android APK)
# Never commit real keys to source control
ELNET_SKEY=0123456789abcdef0123456789abcdef
ELNET_IVKEY=0123456789abcdef

# Optional Firebase Cloud Messaging token (defaults to empty string if unset)
ELNET_FCM_TOKEN=

# Client & Polling Options
ELNET_POLL_INTERVAL_SECONDS=60
ELNET_REQUEST_TIMEOUT_SECONDS=15

# Local Application Settings
ELECTRO_DB_PATH=electro.db
ELECTRO_HOST=127.0.0.1
ELECTRO_PORT=5000
ELECTRO_LOG_LEVEL=INFO
